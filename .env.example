# Copy to .env and fill in by hand. Never commit .env, never paste keys in chat.

# LLM (OpenRouter only; models per tier/task live in apps/api/app/llm/routing.yaml)
OPENROUTER_API_KEY=

# Web search for Deep Research (only if not using OpenRouter's web search)
SEARCH_API_KEY=

# Embeddings (bge-m3): gpu, onnx, or hf (Hugging Face hosted backup)
EMBEDDING_BACKEND=onnx
HF_TOKEN=

# Supabase (also holds the topic_jobs queue during the contest)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Observability (contest: structlog + Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# API security (shared between web and API); CORS includes localhost:3000 from H0
API_KEY=
CORS_ORIGINS=http://localhost:3000,https://<your-vercel-domain>

# Host machine only: named Cloudflare Tunnel on the team domain
CLOUDFLARE_TUNNEL_TOKEN=

# Web (apps/web)
NEXT_PUBLIC_API_URL=https://api.<your-domain>
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# After the contest
# REDIS_URL=redis://localhost:6379/0
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Copy to .env and fill in by hand. Never commit .env, never paste keys in chat.
# On the cloud VM, prefer the VM's attached service account / instance role over key files.

# LLM providers (order per tier/task lives in apps/api/app/llm/routing.yaml)
# Google Cloud — Vertex AI (primary, organizer credits)
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=asia-southeast1
GOOGLE_APPLICATION_CREDENTIALS=
# AWS — Bedrock (backup)
AWS_REGION=ap-southeast-1
AWS_PROFILE=
# OpenRouter (last fallback)
OPENROUTER_API_KEY=

# Web search for Deep Research (search API with domain filtering)
SEARCH_API_KEY=

# Embeddings (bge-m3): gpu, onnx, or hf (Hugging Face hosted backup); weights path inside the container
EMBEDDING_BACKEND=gpu
EMBEDDING_MODEL_PATH=/app/models/bge-m3
HF_TOKEN=

# Supabase (also holds the topic_jobs queue during the contest)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Observability (contest: structlog + Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# API security (shared between web and API); CORS includes localhost:3000 from H0
API_KEY=
CORS_ORIGINS=http://localhost:3000,https://<your-vercel-domain>

# Cloud VM only: named Cloudflare Tunnel on the team domain
CLOUDFLARE_TUNNEL_TOKEN=

# Web (apps/web)
NEXT_PUBLIC_API_URL=https://api.<your-domain>
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# After the contest
# REDIS_URL=redis://localhost:6379/0
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=

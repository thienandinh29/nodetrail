# Copy to .env and fill in by hand. Never commit .env, never paste keys in chat.

# LLM (OpenRouter only; models per tier/task live in apps/api/app/llm/routing.yaml)
OPENROUTER_API_KEY=

# Web search for Deep Research (only if not using OpenRouter's web search)
SEARCH_API_KEY=

# Embeddings (bge-m3): gpu, onnx, or hf (Hugging Face hosted backup)
EMBEDDING_BACKEND=onnx
HF_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Jobs
REDIS_URL=redis://localhost:6379/0

# Observability
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# API security (shared between web and API)
API_KEY=
CORS_ORIGINS=http://localhost:3000

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
